{
  "name": "jessekoerhuis/laravel-event-flags",
  "description": "Utility package for handling event flags in Laravel.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0 || ^12.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "orchestra/testbench": "^9.0 || ^10.0",
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0",
    "larastan/larastan": "^3.0",
    "nesbot/carbon": "^3.0",
    "phpmd/phpmd": "^2.15",
    "slevomat/coding-standard": "^8.0",
    "symplify/easy-coding-standard": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "JesseKoerhuis\\EventFlags\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JesseKoerhuis\\EventFlags\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "JesseKoerhuis\\EventFlags\\EventFlagsServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse -c phpstan.neon",
    "md": "phpmd src,tests text phpmd.xml",
    "ecs": "ecs check",
    "ecs-fix": "ecs check --fix",
    "lint": [
      "@ecs",
      "@stan",
      "@md"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
